{
  "name": "standalone-image-compressor",
  "version": "0.1.1",
  "private": true,
  "description": "本地图片与音频批量压缩桌面工具",
  "main": "desktop/main.cjs",
  "author": "Media Compressor Contributors",
  "scripts": {
    "start": "node server.cjs --open",
    "test": "node --test test/*.test.cjs",
    "desktop": "electron .",
    "build": "node tools/build-desktop.cjs",
    "build:win": "electron-builder --config build/electron-builder.cjs --win --x64",
    "vendor:refresh": "node tools/vendor-dependencies.cjs",
    "test:desktop": "node tools/smoke-desktop.cjs"
  },
  "dependencies": {
    "sharp": "0.33.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "npm": "10.9.10"
  }
}
